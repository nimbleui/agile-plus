{
  "name": "@agile-plus/materials",
  "version": "0.1.2",
  "type": "module",
  "description": "低代码物料插件：把成品组件与 ui 原子件登记成平台的 materials 贡献，纯数据清单与组件名字表分两个产物",
  "license": "MIT",
  "keywords": [
    "lowcode",
    "materials",
    "plugin",
    "manifest",
    "designer",
    "vue"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agile-plus/components": "workspace:*",
    "@agile-plus/ui": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
