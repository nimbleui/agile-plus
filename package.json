{
  "name": "@agile-plus/monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "publish": "pnpm -r --filter \"@agile-plus/*\" --filter \"!@agile-plus/monorepo\" publish",
    "publish:dry": "pnpm -r --filter \"@agile-plus/*\" --filter \"!@agile-plus/monorepo\" publish --dry-run",
    "docs:dev": "pnpm --filter @agile-plus/docs run dev",
    "docs:build": "pnpm --filter @agile-plus/docs run build",
    "docs:preview": "pnpm --filter @agile-plus/docs run preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0 \"packages/*/src/**/*.{ts,vue}\" \"apps/docs/**/*.{ts,vue,mts}\" \"scripts/**/*.mts\" \"*.config.{ts,mjs}\"",
    "format": "prettier --write \"packages/**/*.{ts,vue,json,scss}\" \"apps/**/*.{ts,vue,json,scss,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm docs:build",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
